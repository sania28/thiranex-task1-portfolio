PORT=5000
# Local MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/thiranex_portfolio

# MongoDB Atlas (replace user, password, and cluster with your own)
# MONGODB_URI=mongodb://<db_user>:<db_password>@<cluster-host>:27017/?ssl=true&replicaSet=<replica-set>&authSource=admin

# Email notification settings (Gmail)
# EMAIL_USER is the Gmail account that sends the notification
# EMAIL_PASS is the Gmail App Password (NOT your regular Gmail password)
# EMAIL_TO is where you receive the contact form messages
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_TO=your-email@gmail.com